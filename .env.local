# Local-only overrides — loaded on top of .env by backend/settings.py, only when this file
# exists. NEVER committed (see .gitignore). Only the keys below are overridden; everything else
# (Stripe, email/SMS providers, secrets, etc.) still comes from .env.
#
# Purpose: point the backend at a local PostgreSQL instance instead of the production Supabase
# database in .env, so you can run migrations/tests/manual QA locally before committing, without
# any risk of touching production data.
#
# Setup:
#   1. Make sure PostgreSQL is running locally and create the database once:
#        createdb -p 5433 clinic-management
#      (or via psql: CREATE DATABASE "clinic-management";)
#   2. Values below match the local DB credentials already noted (commented out) in .env.
#   3. Leave DATABASE_URL blank here — that's what makes backend/settings.py fall back to the
#      DB_* fields below instead of the production connection string in .env.
#   4. Run `python manage.py migrate` once to set up the local database's schema.

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=

DB_NAME=clinic-management
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5433

# Local dev should never send real emails/SMS or hit Stripe — these already default this way in
# .env.example, repeated here for clarity in case .env has been changed to real production values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=
HTTPSMS_API_KEY=
HTTPSMS_FROM_NUMBER=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_BASE_URL=http://localhost:4200
